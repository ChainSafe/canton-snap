# Canton Snap dev server port (must match VITE_SNAP_PORT in packages/snap/.env)
VITE_SNAP_PORT=4040

# Default network shown on first load (mainnet | devnet | local)
VITE_DEFAULT_NETWORK=devnet

# Per-network middleware base URLs
VITE_LOCAL_MIDDLEWARE_URL=http://localhost:8081
VITE_DEVNET_MIDDLEWARE_URL=https://middleware-api-dev1.01.chainsafe.dev

# Per-network host labels shown in the network switcher (optional overrides;
# defaults to the hostname parsed from the middleware URL)
# VITE_LOCAL_HOST=localhost:8081
# VITE_DEVNET_HOST=middleware-api-dev1.01.chainsafe.dev
