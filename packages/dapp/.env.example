# Snap source. Unset = published `npm:@chainsafe/canton-snap` (standard MetaMask).
# Set to a local URL to develop against a locally served snap (requires MetaMask Flask):
# VITE_SNAP_ID=local:http://localhost:4040

# Active Canton network (used for the pill label / color preset: mainnet | devnet | local)
VITE_NETWORK=devnet

# Middleware REST API base URL
VITE_MIDDLEWARE_URL=https://middleware-api-dev1.01.chainsafe.dev

# Non-custodial flow toggle. Unset / "false" = v1.0 default (custodial-only:
# registration skips the choice screen and goes straight to custodial). Set
# to "true" to re-enable the registration choice and the snap-backed flow.
# VITE_ENABLE_NON_CUSTODIAL=true

# SIWE sign-in overrides (vite dev server ONLY — docker images always use the
# dapp's own origin, baked at image build). The signed EIP-4361 message's
# domain/uri must match the middleware's `auth` config; they default to the
# dapp's own origin, which is what the deployed middlewares expect. Override
# for setups where the two differ — e.g. the canton-middleware local docker
# stack expects:
# VITE_SIWE_DOMAIN=localhost
# VITE_SIWE_URI=http://localhost
